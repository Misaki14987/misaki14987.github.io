---
import '../../styles/components/units-shell.scss';

interface Props {
  active?: 'home' | 'articles' | 'diary' | 'works';
}

const { active = 'home' } = Astro.props;
---

<div class="units-shell">
  <header class="newspaper-nav">
    <a class="newspaper-nav__brand" href="/">
      <strong>Misaki Journal</strong>
      <span>Personal edition · Hangzhou</span>
    </a>
    <nav aria-label="报纸版面导航">
      <a href="/#articles">Articles</a>
      <a href="/#diary">Diary</a>
      <a href="/#works">Works</a>
    </nav>
  </header>

  <main class="units-main">
    <slot />
  </main>
</div>
