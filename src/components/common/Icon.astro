const { name, size = '1em', label, class: className } = Astro.props;
const isBrand = name in BRAND;
---

<svg
  class:list={['icon', `icon--${name}`, className]}
  viewBox='0 0 24 24'
  width={size}
  height={size}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable='false'
  fill={isBrand ? 'currentColor' : 'none'}
  stroke={isBrand ? undefined : 'currentColor'}
  stroke-width={isBrand ? undefined : 1.5}
  stroke-linecap='round'
  stroke-linejoin='round'
>
  {isBrand ? <path d={BRAND[name]} /> : <Fragment set:html={STROKE[name]} />}
</svg>
