---
import { Image } from 'astro:assets';
import { formatPostDate, storyNames } from '../../../scripts/publication';
import Colophon from '../../common/Colophon.astro';
import Icon from '../../common/Icon.astro';

const { articles, diaries } = Astro.props;
const articleCount = articles.length;
const diaryCount = diaries.length;
const ARTICLE_PREVIEW_LIMIT = 4;
const DIARY_PREVIEW_LIMIT = 3;
const [lead, ...followingArticles] = articles;
const visibleArticles = followingArticles.slice(0, ARTICLE_PREVIEW_LIMIT - 1);
const remainingArticles = followingArticles.slice(ARTICLE_PREVIEW_LIMIT - 1);
const visibleDiaries = diaries.slice(0, DIARY_PREVIEW_LIMIT);
const remainingDiaries = diaries.slice(DIARY_PREVIEW_LIMIT);
const entryTag = (post) => post.tags[0] || post.subtitle || '技术';
---

<div
  id='top'
  class='publication'
  data-od-id='journal-publication'
  data-swipe-href='/about/'
  data-swipe-direction='left'
>
  <section
    class='masthead'
    id='articles'
    data-od-id='masthead'
    aria-labelledby='masthead-title'
  >
    <div class='edition-top publication-meta' aria-label='刊物信息'>
      <span>A Blog With Peaceful Misaki</span>
      <span>Stay live just for FUN</span>
    </div>

    <div class='nameplate' data-nameplate>
      <h1
        class='masthead-title'
        id='masthead-title'
        data-od-id='masthead-heading'
      >
        <span class='title-line'><span>Misaki</span></span>
        <span class='title-line'><span>Journal</span></span>
      </h1>
      <span class='nameplate__roller' aria-hidden='true'></span>
    </div>

    <div class='masthead-grid'>
      <section class='masthead-articles' aria-labelledby='articles-heading'>
        <header class='masthead-articles-head'>
          <h2 id='articles-heading' data-od-id='articles-heading'><Icon name='article' class='section-icon' />Blog</h2>
          <span class='publication-meta' id='article-count'>{articleCount} 篇</span>
        </header>

        {lead && (
          <a class='lead-story' href={lead.link} data-od-id={`article-card-${lead.id}`}>
            {lead.image && (
              <figure class='lead-story__image halftone' style={storyNames(lead.id).cover} data-story={storyNames(lead.id).key}>
                <div class='halftone__print'>
                <Image
                  src={lead.image}
                  alt=''
                  widths={[640, 960, 1280]}
                  sizes='(max-width: 820px) calc(100vw - 72px), 620px'
                  loading='eager'
                  decoding='async'
                />
                </div>
              </figure>
            )}
            <div class='lead-story__meta publication-meta'>
              <time datetime={formatPostDate(lead.pubDate).machine}>
                {formatPostDate(lead.pubDate).display}
              </time>
              <span>{entryTag(lead)}</span>
            </div>
            <h3 class='lead-story__title' style={storyNames(lead.id).title} data-story={storyNames(lead.id).key}><span class='story-title'>{lead.title}</span></h3>
            {lead.description && <p class='lead-story__excerpt'>{lead.description}</p>}
            <span class='lead-story__more'><Icon name='manicule' class='manicule' />阅读全文</span>
          </a>
        )}

        <ol class='entry-list' data-od-id='article-list'>
          {visibleArticles.map((article) => (
            <li class='entry-row' data-od-id={`article-card-${article.id}`}>
              <a class='entry-link' href={article.link}>
                <time class='entry-date' datetime={formatPostDate(article.pubDate).machine}>
                  {formatPostDate(article.pubDate).display}
                </time>
                <span class='entry-title' style={storyNames(article.id).title} data-story={storyNames(article.id).key}><span class='story-title'>{article.title}</span></span>
                <span class='entry-tag publication-meta'>{entryTag(article)}</span>
                <span class='entry-arrow' aria-hidden='true'>→</span>
              </a>
            </li>
          ))}
        </ol>
        {remainingArticles.length > 0 && (
          <details class='archive-more'>
            <summary>查看其余 {remainingArticles.length} 篇文章</summary>
            <ol class='entry-list entry-list--continued'>
              {remainingArticles.map((article) => (
                <li class='entry-row' data-od-id={`article-card-${article.id}`}>
                  <a class='entry-link' href={article.link}>
                    <time class='entry-date' datetime={formatPostDate(article.pubDate).machine}>
                      {formatPostDate(article.pubDate).display}
                    </time>
                    <span class='entry-title' style={storyNames(article.id).title} data-story={storyNames(article.id).key}><span class='story-title'>{article.title}</span></span>
                    <span class='entry-tag publication-meta'>{entryTag(article)}</span>
                    <span class='entry-arrow' aria-hidden='true'>→</span>
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )}
      </section>

      <aside
        class='masthead-folio'
        id='folio'
        data-od-id='folio-section'
        aria-label='日常'
      >
        <section class='folio-column' data-od-id='diary-column' aria-labelledby='diary-heading'>
          <header class='folio-head'>
            <h2 id='diary-heading'><Icon name='daily' class='section-icon' />日常</h2>
            <span class='publication-meta'>{diaryCount} 篇</span>
          </header>
          {diaries.length === 0 && (
            <p class='empty-copy'>暂无日常。</p>
          )}
          <ol class='diary-list'>
            {visibleDiaries.map((diary) => (
              <li>
                <a
                  class='diary-entry'
                  href={diary.link}
                  data-od-id={`diary-entry-${diary.id}`}
                >
                  <time datetime={formatPostDate(diary.pubDate).machine}>
                    {formatPostDate(diary.pubDate).display}
                  </time>
                  <strong style={storyNames(diary.id).title} data-story={storyNames(diary.id).key}><span class='story-title'>{diary.title}</span></strong>
                  <span class='entry-arrow' aria-hidden='true'>→</span>
                </a>
              </li>
            ))}
          </ol>
          {remainingDiaries.length > 0 && (
            <details class='archive-more diary-more'>
              <summary>查看其余 {remainingDiaries.length} 篇日常</summary>
              <ol class='diary-list'>
                {remainingDiaries.map((diary) => (
                  <li>
                    <a
                      class='diary-entry'
                      href={diary.link}
                      data-od-id={`diary-entry-${diary.id}`}
                    >
                      <time datetime={formatPostDate(diary.pubDate).machine}>
                        {formatPostDate(diary.pubDate).display}
                      </time>
                      <strong style={storyNames(diary.id).title} data-story={storyNames(diary.id).key}><span class='story-title'>{diary.title}</span></strong>
                      <span class='entry-arrow' aria-hidden='true'>→</span>
                    </a>
                  </li>
                ))}
              </ol>
            </details>
          )}
        </section>

      </aside>
    </div>
  </section>

  <Colophon />
</div>

<a
  class='page-edge-link page-edge-link--next'
  href='/about/'
  aria-label='进入 Profile'
  title='进入 Profile'
>
  <span aria-hidden='true'>→</span>
  <small>Profile</small>
</a>
