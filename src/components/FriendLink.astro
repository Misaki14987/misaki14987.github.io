---
import '../styles/components/friend-link.scss';

const friends = [
    { name: 'summ2', url: 'https://summ2.link', description: 'Vidar Team Pwn, awmc', image: '/images/friends/summ2.png' },
    { name: 'nan0in', url: 'https://nan0in27.cn', description: 'ORAYS Pwn, Hack for fun', image: '/images/friends/nan0in.webp' }
]
---

<section class="friend-section" aria-labelledby="friend-heading">
  <header class="friend-section__head">
    <h2 id="friend-heading" class="friend-section__title">友链</h2>
    <span class="publication-meta">{friends.length} 位朋友</span>
  </header>

  <div class="friend-section__list">
    {friends.map((friend) => (
      <article class="friend-entry">
        {friend.image && (
          <a href={friend.url} target="_blank" rel="noopener noreferrer" class="friend-entry__avatar">
            <img
              src={friend.image}
              alt={friend.name}
              loading="lazy"
              decoding="async"
              width="64"
              height="64"
            />
          </a>
        )}

        <div class="friend-entry__body">
          <h3 class="friend-entry__name">
            <a href={friend.url} target="_blank" rel="noopener noreferrer">{friend.name}</a>
          </h3>

          {friend.description && (
            <p class="friend-entry__desc">{friend.description}</p>
          )}
        </div>
        <span class="friend-entry__arrow" aria-hidden="true">↗</span>
      </article>
    ))}
  </div>
</section>
