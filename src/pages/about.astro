---
import BaseLayout from '../layouts/BaseLayout.astro';
import FriendLink from '../components/FriendLink.astro';
import '../styles/pages/about.scss';
import { CONTACT_LINKS, SITE_TITLE } from '../config/site';

const myInfo = {
  name: '米撒奇',
  bio: '怡泉大好き,能和我写一辈子前端吗',
};

const profileStats = [
  ['Location', 'China.Zhejiang.Hangzhou / Hangzhou Dianzi University'],
  ['Direction', 'Frontend Development / Agent '],
  ['Tech Stack', 'React / Node.js / TypeScript / Elysia / Astro / TailwindCSS / Vite / Python / FastAPI / LangChain'],
  ['Hobby', 'Rhythm game / Visual Novel / 偶像和女声优'],
];
---

<BaseLayout
  title={`Profile | ${SITE_TITLE}`}
  description="关于 M1saK1"
  hideNavigation
>
  <main
    class="publication profile-publication"
    data-swipe-href="/"
    data-swipe-direction="right"
  >
    <section class="profile-sheet page-reveal" aria-labelledby="profile-title">
      <div class="edition-top publication-meta" aria-label="页面信息">
        <span>A Introversion Misaki</span>
        <span>Profile </span>
      </div>

      <div class="profile-grid">
        <header class="profile-identity">
          <span class="profile-kicker publication-meta">M1saK1</span>
          <h1 id="profile-title">{myInfo.name}</h1>
          <p>{myInfo.bio}</p>
        </header>

        <section class="profile-dossier" aria-labelledby="dossier-heading">
          <header class="profile-section-head">
            <h2 id="dossier-heading">Profile</h2>
          </header>
          <dl class="profile-stats">
            {profileStats.map(([term, value], index) => (
              <div>
                <dt>{term}</dt>
                <dd>{value}</dd>
              </div>
            ))}
          </dl>
        </section>

      </div>

      <FriendLink />
    </section>

    <footer class="colophon profile-colophon">
      <strong>Misaki Journal</strong>
      <nav class="colophon-links" aria-label="联系方式">
        {CONTACT_LINKS.map((link) => (
          <a
            class="letter-link"
            href={link.href}
            target={link.external ? '_blank' : undefined}
            rel={link.external ? 'noopener noreferrer' : undefined}
          >
            {link.label}
          </a>
        ))}
      </nav>
    </footer>
  </main>

  <a
    class="page-edge-link page-edge-link--previous"
    href="/"
    aria-label="返回首页"
    title="返回首页"
  >
    <span aria-hidden="true">←</span>
    <small>首页</small>
  </a>
</BaseLayout>
