---
import BaseLayout from '../layouts/BaseLayout.astro';
import BlogCard from '../components/BlogCard.astro';
import { getPostCards, getPublishedPosts } from '../scripts/publication';
import { SITE_CONFIG, SITE_TITLE } from '../config/site';
import '../styles/pages/index.scss';

const blogs = getPostCards(await getPublishedPosts());
const tags = [...new Set(blogs.flatMap((blog) => blog.tags ?? []))]
  .filter(Boolean)
  .sort((a, b) => a.localeCompare(b, 'zh-CN'));
---

<BaseLayout
  title={SITE_TITLE}
  description={SITE_CONFIG.description}
  ogImage="/images/home-og.png"
  bodyClass="home-page"
>
  <div class="home" data-home-scenes data-active-scene="intro">
    <nav class="scene-switcher" aria-label="首页场景">
      <div class="scene-switcher__tabs">
        <button type="button" data-scene-target="intro" aria-pressed="true">
          <span>01</span>
          首页
        </button>
        <button type="button" data-scene-target="articles" aria-pressed="false">
          <span>02</span>
          文章
        </button>
      </div>
      <div class="scene-switcher__arrows">
        <button type="button" data-scene-step="-1" aria-label="上一个场景">←</button>
        <button type="button" data-scene-step="1" aria-label="下一个场景">→</button>
      </div>
    </nav>

    <div class="scene-viewport">
    <section class="opening home-scene is-active" data-scene="intro">
      <div class="opening__media" aria-hidden="true">
        <canvas data-hero-field data-note-count={blogs.length}></canvas>
      </div>

      <div class="opening__topline" aria-hidden="true">
        <span>{SITE_CONFIG.home.topline}</span>
        <span>Shanghai / CN</span>
        <span>Since 2025</span>
      </div>

      <div class="opening__statement page-reveal">
        <h1>
          {SITE_CONFIG.home.headline.map((line, index) => (
            <span>{line}{index === 2 && <i aria-hidden="true">*</i>}</span>
          ))}
        </h1>
        <p class="opening__eyebrow">{SITE_CONFIG.home.eyebrow}</p>
        <button class="opening__switch" type="button" data-scene-target="articles">
          <span class="opening__switch-icon" aria-hidden="true">↘</span>
          <span>{SITE_CONFIG.home.browseLabel}</span>
        </button>
      </div>
    </section>

    <section class="notebook home-scene" data-scene="articles" hidden>
      <section class="note-ledger page-reveal page-reveal--delay-1">
        <header class="note-ledger__head">
          <div>
            <h2>{SITE_CONFIG.home.archiveTitle}</h2>
          </div>
          <a href="/tags/">{SITE_CONFIG.home.archiveLinkLabel} ↗</a>
        </header>

        <form class="note-tools" data-note-tools>
          <label class="note-search">
            <span>搜索</span>
            <input
              type="search"
              name="q"
              placeholder="标题、摘要或标签"
              autocomplete="off"
              data-note-search
            />
            <kbd>/</kbd>
          </label>

          <label class="note-select">
            <span>标签</span>
            <select name="tag" data-note-tag>
              <option value="">全部</option>
              {tags.map((tag) => <option value={tag}>{tag}</option>)}
            </select>
          </label>

          <label class="note-select">
            <span>排序</span>
            <select name="sort" data-note-sort>
              <option value="newest">最新优先</option>
              <option value="oldest">最早优先</option>
            </select>
          </label>

          {SITE_CONFIG.home.filters.length > 0 && (
            <div class="tone-filter" role="group" aria-label="内容主题">
              {SITE_CONFIG.home.filters.map((filter, index) => (
                <button
                  type="button"
                  data-tone-filter={filter.value}
                  aria-pressed={index === 0 ? 'true' : 'false'}
                >
                  {filter.label}
                </button>
              ))}
            </div>
          )}
        </form>

        <div class="note-results" aria-live="polite">
          <span data-note-count>{blogs.length} 篇</span>
          <button type="button" data-note-reset hidden>清除筛选</button>
        </div>

        <div class="note-ledger__list">
          {blogs.map((blog, i) => (
            <BlogCard
              title={blog.title}
              subtitle={blog.subtitle}
              image={blog.image}
              link={blog.link}
              description={blog.description}
              pubDate={blog.pubDate}
              tags={blog.tags}
              entryId={blog.entryId}
              tone={blog.tone}
              priority={i === 0}
              class="archive-entry--compact"
            />
          ))}
        </div>
        <p class="note-empty" data-note-empty hidden>没有符合条件的文章。</p>
      </section>
    </section>
    </div>
  </div>
</BaseLayout>

<script>
  import { mountHomePage } from "../scripts/client/home";

  mountHomePage();
</script>
