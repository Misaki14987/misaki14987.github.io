---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags, getPostsByTag, getPublishedPosts, tagPath } from '../../scripts/publication';
import '../../styles/pages/tag.scss';
import { SITE_TITLE } from '../../config/site';

const posts = await getPublishedPosts();
const tags = getAllTags(posts).map((tag) => ({
  name: tag,
  count: getPostsByTag(posts, tag).length,
}));
---

<BaseLayout
  title={`Tags | ${SITE_TITLE}`}
  description='标签'
  ogImage="/images/home-og.png"
>
  <div class="publication tag-sheet">
    <section class="masthead" aria-labelledby="tags-title">
      <div class="edition-top publication-meta">
        <span>Misaki Journal · Index</span>
        <span>{tags.length} 个标签</span>
      </div>

      <h1 class="tag-title" id="tags-title">标签</h1>

      <ol class="entry-list">
        {tags.map((tag, index) => (
          <li class="entry-row">
            <a class="entry-link" href={tagPath(tag.name)}>
              <span class="entry-date">{String(index + 1).padStart(2, '0')}</span>
              <span class="entry-title">{tag.name}</span>
              <span class="entry-tag publication-meta">{tag.count} 篇</span>
              <span class="entry-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>
