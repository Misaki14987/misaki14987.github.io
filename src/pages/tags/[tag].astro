---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
    getAllTags,
    getPostsByTag,
    getPublishedPosts,
    formatPostDate,
    postPath,
    storyNames,
} from '../../scripts/publication';
import '../../styles/pages/tag.scss';
import { SITE_TITLE } from '../../config/site';

export async function getStaticPaths() {
    const allPosts = await getPublishedPosts();
    return getAllTags(allPosts).map((tag) => ({
        params: { tag },
        props: { posts: getPostsByTag(allPosts, tag) },
    }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const cards = posts.map((post) => ({
    id: post.id,
    title: post.data.title,
    link: postPath(post),
    date: formatPostDate(post.data.pubDate),
    kind: post.data.kind === 'diary' ? '日常' : '文章',
}));
---

<BaseLayout
    title={`${tag} | ${SITE_TITLE}`}
    description={`标签 ${tag}`}
    ogImage="/images/vn-blog-hero.png"
>
    <div class="publication tag-sheet">
        <section class="masthead" aria-labelledby="tag-title">
            <div class="edition-top publication-meta">
                <a href="/tags/" data-turn="back">← 全部标签</a>
                <span>{cards.length} 篇</span>
            </div>

            <h1 class="tag-title" id="tag-title"><span aria-hidden="true">#</span>{tag}</h1>

            <ol class="entry-list">
                {cards.map((post) => (
                    <li class="entry-row">
                        <a class="entry-link" href={post.link}>
                            <time class="entry-date" datetime={post.date.machine}>{post.date.display}</time>
                            <span class="entry-title" style={storyNames(post.id).title} data-story={storyNames(post.id).key}><span class="story-title">{post.title}</span></span>
                            <span class="entry-tag publication-meta">{post.kind}</span>
                            <span class="entry-arrow" aria-hidden="true">→</span>
                        </a>
                    </li>
                ))}
            </ol>
        </section>
    </div>
</BaseLayout>
