---
import BaseLayout from './BaseLayout.astro';
import { Image } from 'astro:assets';
import {
    formatPostDate,
    postPath,
    postTone,
    storyNames,
    tagPath,
    type PostEntry,
} from '../scripts/publication';
import type { MarkdownHeading } from 'astro';
import 'katex/dist/katex.min.css';
import '../styles/layouts/markdown-layout.scss';
import { SITE_TITLE } from '../config/site';
import Colophon from '../components/common/Colophon.astro';
import Icon from '../components/common/Icon.astro';
import Comments from '../components/Comments.astro';

const {
    frontmatter,
    postId,
    canonical,
    seoDescription,
    headings = [],
    readingMinutes,
    previousPost,
    nextPost,
} = Astro.props as {
    frontmatter: Record<string, any>;
    postId: string;
    canonical?: string;
    seoDescription?: string;
    headings?: MarkdownHeading[];
    readingMinutes?: number;
    previousPost?: PostEntry;
    nextPost?: PostEntry;
};
const {
    title,
    description,
    pubDate,
    updatedDate,
    author,
    kind = 'article',
    tags = [],
    category,
    cover,
} = frontmatter;
const pageDescription = seoDescription ?? description;

const tone = postTone({ title, subtitle: category, tags });
const kindLabel = kind === 'diary' ? '日常' : '文章';
const published = formatPostDate(pubDate);
const updated = updatedDate && formatPostDate(updatedDate);
const tocHeadings = headings.filter(({ depth }) => depth === 2 || depth === 3);
const names = storyNames(postId);
const adjacentPost = (post?: PostEntry) => post && ({
    id: post.id,
    title: post.data.title,
    href: postPath(post),
    date: formatPostDate(post.data.pubDate).display,
    cover: post.data.cover,
});
// Feature the older story as the natural next read; the newer one gets a quiet link.
const featured = adjacentPost(previousPost ?? nextPost);
const secondary = previousPost ? adjacentPost(nextPost) : undefined;
const featuredLabel = previousPost ? '上一篇' : '下一篇';
---

<BaseLayout
    title={`${title} | ${SITE_TITLE}`}
    description={pageDescription}
    canonical={canonical}
    ogType='article'
    ogImage={cover?.src}
    ogImageAlt={title}
    publishedTime={pubDate}
    modifiedTime={updatedDate}
    tags={tags}
>
    <article
        class='post-sheet'
        data-tone={tone}
        data-pagefind-meta={`kind:${kindLabel}`}
    >
        <header class='post-masthead'>
            <div class='edition-top publication-meta'>
                <span>Misaki Journal · {kindLabel}</span>
                {category && <span>{category}</span>}
            </div>

            <div class='post-masthead__grid'>
                <dl class='post-dateline'>
                    <div>
                        <dt><Icon name='calendar' />发布</dt>
                        <dd><time datetime={published.machine} data-pagefind-meta='date'>{published.display}</time></dd>
                    </div>
                    {updated && (
                        <div>
                            <dt><Icon name='pencil' />更新</dt>
                            <dd><time datetime={updated.machine}>{updated.display}</time></dd>
                        </div>
                    )}
                    {readingMinutes && (
                        <div>
                            <dt><Icon name='hourglass' />阅读</dt>
                            <dd>约 {readingMinutes} 分钟</dd>
                        </div>
                    )}
                    {author && (
                        <div>
                            <dt><Icon name='pen' />作者</dt>
                            <dd>{author}</dd>
                        </div>
                    )}
                    <div class='visit-count'>
                        <dt><Icon name='glasses' />浏览</dt>
                        <dd><b id='vercount_value_page_pv'></b> 次</dd>
                    </div>
                </dl>

                <div class='post-masthead__main'>
                    <h1 class='post-title' style={names.title} data-story={names.key} data-pagefind-meta='title'><span class='story-title'>{title}</span></h1>
                    {description && <p class='post-standfirst'>{description}</p>}
                    {tags.length > 0 && (
                        <ul class='post-tags' aria-label='标签'>
                            {tags.map((tag: string) => (
                                <li><a href={tagPath(tag)}>#{tag}</a></li>
                            ))}
                        </ul>
                    )}
                </div>
            </div>
        </header>

        {cover && (
            <figure class='post-cover' style={names.cover} data-story={names.key}>
                <Image
                    src={cover}
                    alt={title}
                    widths={[720, 960, 1200]}
                    sizes='(max-width: 1220px) calc(100vw - 40px), 1056px'
                    loading='eager'
                    decoding='async'
                />
            </figure>
        )}

        <div class='post-reading'>
            {tocHeadings.length > 0 && (
                <aside class='post-toc' data-post-toc>
                    <button
                        class='post-toc__toggle'
                        type='button'
                        aria-expanded='false'
                        data-toc-toggle
                    >
                        目录
                        <span aria-hidden='true'>+</span>
                    </button>
                    <nav aria-label='文章目录' data-toc-list>
                        <span class='post-toc__title publication-meta'>目录</span>
                        <ol>
                            {tocHeadings.map((heading) => (
                                <li data-depth={heading.depth}>
                                    <a href={`#${heading.slug}`} data-toc-link={heading.slug}>
                                        {heading.text}
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </nav>
                </aside>
            )}

            <div class='post-reading__main'>
                <div class='article-content' data-article-content data-pagefind-body>
                    <slot />
                </div>
                <p class='post-endmark' aria-hidden='true'>■</p>

                <Comments />
            </div>
        </div>

        {featured && (
            <nav class='continue-reading' aria-label='继续阅读'>
                <a class='continue-reading__feature' href={featured.href}>
                    <span class='continue-reading__label publication-meta'>继续阅读 · {featuredLabel} · {featured.date}</span>
                    <strong class='continue-reading__title' style={storyNames(featured.id).title} data-story={storyNames(featured.id).key}>
                        <span class='story-title'>{featured.title}</span>
                    </strong>
                    {featured.cover && (
                        <figure class='continue-reading__cover halftone' style={storyNames(featured.id).cover} data-story={storyNames(featured.id).key}>
                            <div class='halftone__print'><Image src={featured.cover} alt='' widths={[480, 720]} sizes='(max-width: 820px) 100vw, 360px' /></div>
                        </figure>
                    )}
                    <span class='continue-reading__arrow' aria-hidden='true'><Icon name='manicule' /></span>
                </a>
                {secondary && (
                    <a class='continue-reading__secondary' href={secondary.href}>
                        <span class='publication-meta'>下一篇 · {secondary.date}</span>
                        <strong>{secondary.title}</strong>
                        <span aria-hidden='true'>→</span>
                    </a>
                )}
            </nav>
        )}

        <Colophon />
    </article>

    <button class='back-to-top' type='button' data-back-to-top aria-label='返回顶部'>
        <span aria-hidden='true'>↑</span>
        顶部
    </button>
</BaseLayout>

<script>
  import { mountPostPage } from "../scripts/client/post";
  import { mountComments } from "../scripts/client/comments";

  mountPostPage();
  mountComments();
</script>
