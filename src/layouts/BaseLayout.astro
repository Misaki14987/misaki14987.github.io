---
import '../global.scss';
import '../styles/layouts/base-layout.scss';
import '../styles/themes/newspaper.scss';
import SiteHead from '../components/common/SiteHead.astro';
import ArchiveLoader from '../components/common/ArchiveLoader.astro';
import SystemFrame from '../components/common/SystemFrame.astro';
import { SITE_TITLE } from '../scripts/seo';
import { SITE_CONFIG, SITE_VARIANT } from '../config/site';

const {
    title = SITE_TITLE,
    description,
    bodyClass = '',
    canonical,
    ogType = 'website',
    ogImage,
    ogImageAlt = title,
    publishedTime,
    modifiedTime,
    tags = [],
} = Astro.props;
---
<html lang='zh-CN' data-theme={SITE_CONFIG.theme}>
  <head>
    <SiteHead
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    <slot name='head' />
  </head>

  <body class={`body ${bodyClass}`}>
    {SITE_VARIANT === 'learning' && (
      <>
        <SystemFrame />
        <ArchiveLoader />
      </>
    )}
    <main class='main'>
      <slot />
    </main>

    <script>
      import { initializeSiteRuntime } from "../scripts/client/site-runtime";

      initializeSiteRuntime();
    </script>
  </body>
</html>
