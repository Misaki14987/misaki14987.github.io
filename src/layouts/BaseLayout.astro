---
// Fonts are bundled and served from this site: no third-party font hosts,
// which are slow or blocked for many readers in mainland China.
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/noto-serif-sc';
import '@fontsource-variable/fira-code';
import 'lxgw-wenkai-screen-webfont/lxgwwenkaigbscreen.css';
import '../global.scss';
import '../styles/layouts/base-layout.scss';
import '../styles/themes/london-newspaper.scss';
import '../styles/motion.scss';
import SiteHead from '../components/common/SiteHead.astro';
import SiteNav from '../components/common/SiteNav.astro';
import { SITE_TITLE } from '../scripts/seo';

const {
    title = SITE_TITLE,
    description,
    bodyClass = '',
    canonical,
    ogType = 'website',
    ogImage,
    ogImageAlt = title,
    publishedTime,
    modifiedTime,
    tags = [],
    deferBrand = false,
} = Astro.props;
---

<html lang='zh-CN' data-theme='london-newspaper'>
  <head>
    <SiteHead
      title={title}
      description={description}
      canonical={canonical}
      ogType={ogType}
      ogImage={ogImage}
      ogImageAlt={ogImageAlt}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      tags={tags}
    />
    <slot name='head' />
  </head>

  <body class={`body ${bodyClass}`}>
    <SiteNav deferBrand={deferBrand} />
    <main class='main'>
      <slot />
    </main>

    <script>
      import { initializeSiteRuntime } from "../scripts/client/site-runtime";

      initializeSiteRuntime();
    </script>
  </body>
</html>
